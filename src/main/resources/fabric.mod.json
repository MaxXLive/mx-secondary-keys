{
	"schemaVersion": 1,
	"id": "mxsecondarykeys",
	"version": "${version}",
	"name": "MX Secondary Keys",
	"description": "Adds a second, independent key binding to every action (vanilla and modded) without touching the primary one. Configure it via Options > Controls > Secondary Keybinds or by pressing K.",
	"authors": [
		"maxxlive"
	],
	"contact": {
		"sources": "https://github.com/MaxXLive/mx-secondary-keys",
		"issues": "https://github.com/MaxXLive/mx-secondary-keys/issues"
	},
	"license": "MIT",
	"icon": "assets/mxsecondarykeys/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.ermackov.secondarykeys.SecondaryKeys"
		]
	},
	"mixins": [
		"mxsecondarykeys.mixins.json"
	],
	"accessWidener": "mxsecondarykeys.classtweaker",
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": ">=26.3"
	}
}
